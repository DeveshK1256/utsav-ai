# ==============================================================================
# UTSAV CELEBRATION PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env (or backend/.env) and fill in your values.
# NEVER commit .env or real secret keys to source control.
# ==============================================================================

# Core Application Settings
PROJECT_NAME="Utsav"
VERSION="1.0.0-RELEASE"
ENVIRONMENT="development"
PORT=8000

# Database Configuration
# Local development default: SQLite
DATABASE_URL="sqlite:///./utsav_dev.db"
# Production example:
# DATABASE_URL="postgresql://user:password@hostname:5432/utsav_db?sslmode=require"

# Google Gemini API
# Server-side only; required for live multimodal quotation audit and tradition merging.
# In local/offline testing, omit this key to activate deterministic offline stubs automatically.
GEMINI_API_KEY=""

# Feature Flags
ENABLE_M4_WHATSAPP="false"

# Meta WhatsApp Cloud API (Paused / Optional)
WHATSAPP_PROVIDER="mock"
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Frontend Configuration (for Next.js in frontend/.env.local)
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
